{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (Ninja, Debug, GUI on)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KUIPER_IMAGER_GUI": "ON"
      }
    },
    {
      "name": "cli-only",
      "displayName": "CLI only (no Qt Widgets/GUI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cli",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KUIPER_IMAGER_GUI": "OFF"
      }
    },
    {
      "name": "deb-linux",
      "displayName": "Debian package (distro Qt, CLI only)",
      "description": "Builds kli against the distro's Qt (6.4+) with CPack DEB packaging enabled. Distinct from ci-linux, which builds against aqtinstall Qt 6.8. Intended for the debian:12 packaging container.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-deb",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KUIPER_IMAGER_GUI": "OFF",
        "KUIPER_IMAGER_PACKAGE": "ON"
      }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "description": "Shared CI settings. Everything OS-specific belongs in the ci-<os> presets below, so the workflow stays identical across the matrix.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KUIPER_IMAGER_GUI": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci-linux",
      "inherits": "ci-base",
      "displayName": "CI — Linux (Ninja, Release)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ci-macos",
      "inherits": "ci-base",
      "displayName": "CI — macOS (Ninja, Release)",
      "description": "Not yet exercised by CI. The macOS device backend is a stub; enable the matrix row when the port lands.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },
    {
      "name": "ci-windows",
      "inherits": "ci-base",
      "displayName": "CI — Windows (Ninja, Release, MSVC)",
      "description": "Requires the developer command prompt environment (e.g. ilammy/msvc-dev-cmd) to be sourced before configuring. Dependencies (libarchive, OpenSSL, curl) come from vcpkg in manifest mode; set VCPKG_ROOT before configuring.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-installer",
      "inherits": "ci-windows",
      "displayName": "Windows installer (NSIS, Release)",
      "description": "Same toolchain as ci-windows, with CPack NSIS packaging enabled to produce a Kuiper Imager setup.exe.",
      "binaryDir": "${sourceDir}/build-windows-installer",
      "cacheVariables": {
        "KUIPER_IMAGER_PACKAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "cli-only", "configurePreset": "cli-only" },
    { "name": "deb-linux", "configurePreset": "deb-linux" },
    { "name": "ci-linux", "configurePreset": "ci-linux" },
    { "name": "ci-macos", "configurePreset": "ci-macos" },
    { "name": "ci-windows", "configurePreset": "ci-windows" },
    { "name": "windows-installer", "configurePreset": "windows-installer" }
  ]
}
