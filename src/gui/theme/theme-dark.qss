/* GENERATED by src/gui/theme/tools/gen_theme.mjs — do not edit.
   Harmonic dark theme. Regenerate: node src/gui/theme/tools/gen_theme.mjs */

/* --- app surfaces --- */
QWidget {
    background-color: #101820;
    color: #ffffff;
    font-family: "Inter";
    font-size: 14px;
}
QMainWindow, QDialog { background-color: #101820; }

QTableWidget, QTableView {
    background-color: #293038;
    alternate-background-color: #101820;
    gridline-color: #4b545d;
    border: 1px solid #4b545d;
    border-radius: 4px;
    selection-background-color: #92befc;
    selection-color: #101820;
}
QHeaderView::section {
    background-color: #293038;
    color: #848b95;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #4b545d;
    font-weight: 600;
}
QStatusBar { color: #848b95; }
QStatusBar QLabel { color: #848b95; }

/* --- HmcButton (QPushButton skin, keyed on dynamic props) --- */
QPushButton[hmc="true"] {
    border: none;
    border-radius: 4px;
    font-family: "Inter";
    font-weight: 600;
    font-size: 14px;
    min-height: 40px;
    padding: 0 16px;
}
QPushButton[hmc="true"][size="md"] {
    min-height: 40px; padding: 0 16px; font-size: 14px;
}
QPushButton[hmc="true"][size="sm"] {
    min-height: 32px; padding: 0 12px; font-size: 14px;
}
QPushButton[hmc="true"][size="xs"] {
    min-height: 24px; padding: 0 8px; font-size: 12px;
}
QPushButton[hmc="true"][kind="primary"] {
    background-color: #92befc;
    color: #101820;
}
QPushButton[hmc="true"][kind="primary"]:hover,
QPushButton[hmc="true"][kind="primary"]:pressed {
    background-color: #edf3fc;
    color: #101820;
}
QPushButton[hmc="true"][kind="primary"]:disabled,
QPushButton[hmc="true"][kind="primary"][processing="true"] {
    background-color: rgba(58, 142, 233, 0.4);
    color: #101820;
}
QPushButton[hmc="true"][kind="secondary"] {
    background-color: transparent;
    border: 1px solid #92befc;
    color: #92befc;
}
QPushButton[hmc="true"][kind="secondary"]:hover,
QPushButton[hmc="true"][kind="secondary"]:pressed {
    background-color: rgba(0, 103, 185, 0.55);
    border: 1px solid #edf3fc;
    color: #edf3fc;
}
QPushButton[hmc="true"][kind="secondary"]:disabled,
QPushButton[hmc="true"][kind="secondary"][processing="true"] {
    border: 1px solid rgba(58, 142, 233, 0.4);
    color: rgba(58, 142, 233, 0.4);
}
QPushButton[hmc="true"][kind="tertiary"] {
    background-color: transparent;
    border: 1px solid #848b95;
    color: #ffffff;
}
QPushButton[hmc="true"][kind="tertiary"]:hover,
QPushButton[hmc="true"][kind="tertiary"]:pressed {
    background-color: rgba(94, 103, 115, 0.5);
    border: 1px solid #b7bbc3;
    color: #ffffff;
}
QPushButton[hmc="true"][kind="tertiary"]:disabled,
QPushButton[hmc="true"][kind="tertiary"][processing="true"] {
    border: 1px solid rgba(132, 139, 149, 0.58);
    color: #848b95;
}
QPushButton[hmc="true"][kind="ghost"] {
    background-color: transparent;
    color: #ffffff;
}
QPushButton[hmc="true"][kind="ghost"]:hover,
QPushButton[hmc="true"][kind="ghost"]:pressed {
    background-color: rgba(94, 103, 115, 0.5);
    color: #ffffff;
}
QPushButton[hmc="true"][kind="ghost"]:disabled,
QPushButton[hmc="true"][kind="ghost"][processing="true"] {
    color: rgba(132, 139, 149, 0.58);
}
QPushButton[hmc="true"]:focus {
    border: 2px solid #b16ee0;
}

/* --- HmcCard --- */
QFrame[hmcCard="true"] {
    background-color: #293038;
    border: 1px solid #4b545d;
    border-radius: 8px;
}
/* --- HmcContainerHeader --- */
QLabel[hmcHeading="true"] { color: #ffffff; font-weight: 700; font-size: 16px; }
QLabel[hmcHeading="true"][density="low"] { font-size: 20px; font-weight: 600; }
QLabel[hmcSubtitle="true"] { color: #b7bbc3; font-weight: 400; font-size: 14px; }
QLabel[hmcCaption="true"] { color: #848b95; font-size: 12px; }
/* --- HmcTag --- */
QLabel[hmcTag="true"][status="info"] {
    background-color: #3a424b; color: #ffffff;
    border: 1px solid #5e6773; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
QLabel[hmcTag="true"][status="success"] {
    background-color: #114a32; color: #ffffff;
    border: 1px solid #2e9e6f; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
QLabel[hmcTag="true"][status="warning"] {
    background-color: #702c0a; color: #ffffff;
    border: 1px solid #e76423; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
QLabel[hmcTag="true"][status="danger"] {
    background-color: #840d17; color: #ffffff;
    border: 1px solid #ffa3ab; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
QLabel[hmcTag="true"][status="highlight"] {
    background-color: #5d2287; color: #ffffff;
    border: 1px solid #b16ee0; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
/* --- HmcProgressBar --- */
QProgressBar[hmcProgress="true"] {
    background-color: rgba(132, 139, 149, 0.43);
    border: none; border-radius: 4px; max-height: 8px; min-height: 8px;
}
QProgressBar[hmcProgress="true"]::chunk { background-color: #92befc; border-radius: 4px; }
QProgressBar[hmcProgress="true"][status="success"]::chunk { background-color: #2e9e6f; }
QProgressBar[hmcProgress="true"][status="danger"]::chunk { background-color: #ffa3ab; }
/* --- HmcSegmentedControl --- */
QFrame[hmcSegmented="true"] { border: 1px solid #848b95; border-radius: 4px; }
QPushButton[hmcSegment="true"] {
    border: none; border-radius: 0; background-color: transparent;
    color: #ffffff;
    padding: 0 16px; min-height: 38px; font-size: 14px; font-weight: 600;
}
QPushButton[hmcSegment="true"][pos="mid"], QPushButton[hmcSegment="true"][pos="last"] {
    border-left: 1px solid #848b95;
}
QPushButton[hmcSegment="true"][pos="first"] { border-top-left-radius: 3px; border-bottom-left-radius: 3px; }
QPushButton[hmcSegment="true"][pos="last"] { border-top-right-radius: 3px; border-bottom-right-radius: 3px; }
QPushButton[hmcSegment="true"]:checked {
    background-color: rgba(0, 103, 185, 0.18);
    color: #92befc;
}
/* --- HmcCheckBox --- */
QCheckBox[hmcCheck="true"] { color: #ffffff; spacing: 8px; font-size: 14px; }
QCheckBox[hmcCheck="true"]::indicator {
    width: 16px; height: 16px; border-radius: 4px;
    border: 1px solid #848b95;
    background-color: #293038;
}
QCheckBox[hmcCheck="true"]::indicator:hover { border-color: #b7bbc3; }
QCheckBox[hmcCheck="true"]::indicator:checked {
    border: none; background-color: #92befc;
    image: url(:/theme/check.svg);
}
/* --- HmcBanner (subtle) --- */
QFrame[hmcBanner="true"][status="info"] {
    background-color: #3a424b; border: 1px solid #5e6773; border-radius: 8px;
}
QFrame[hmcBanner="true"][status="info"] QLabel { color: #ffffff; background: transparent; }
QFrame[hmcBanner="true"][status="success"] {
    background-color: #114a32; border: 1px solid #2e9e6f; border-radius: 8px;
}
QFrame[hmcBanner="true"][status="success"] QLabel { color: #ffffff; background: transparent; }
QFrame[hmcBanner="true"][status="warning"] {
    background-color: #702c0a; border: 1px solid #e76423; border-radius: 8px;
}
QFrame[hmcBanner="true"][status="warning"] QLabel { color: #ffffff; background: transparent; }
QFrame[hmcBanner="true"][status="danger"] {
    background-color: #840d17; border: 1px solid #ffa3ab; border-radius: 8px;
}
QFrame[hmcBanner="true"][status="danger"] QLabel { color: #ffffff; background: transparent; }
QFrame[hmcBanner="true"][status="highlight"] {
    background-color: #5d2287; border: 1px solid #b16ee0; border-radius: 8px;
}
QFrame[hmcBanner="true"][status="highlight"] QLabel { color: #ffffff; background: transparent; }
