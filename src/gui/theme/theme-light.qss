/* Kuiper GUI theme — light. Hand-authored Qt stylesheet.
   Keep theme-light.qss and theme-dark.qss in sync; Tokens.hpp carries the
   QColor constants that custom-painted widgets read. */

/* --- app surfaces --- */
/* Base text/font only — NOT background: a universal background-color would paint
   every child (labels, rows) and hide the card surfaces. The canvas colour is set
   on the window instead, and children stay transparent unless a rule opts in. */
QWidget {
    color: #101820;
    font-family: "Inter";
    font-size: 14px;
}
QMainWindow, QDialog { background-color: #f0f1f3; }

QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f0f1f3;
    gridline-color: #b7bbc3;
    border: 1px solid #b7bbc3;
    border-radius: 4px;
    selection-background-color: #0067b9;
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: #ffffff;
    color: #848b95;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #b7bbc3;
    font-weight: 600;
}
QStatusBar { color: #848b95; }
QStatusBar QLabel { color: #848b95; }

/* --- KuiperButton (QPushButton skin, keyed on dynamic props) --- */
QPushButton[kuiperButton="true"] {
    border: none;
    border-radius: 4px;
    font-family: "Inter";
    font-weight: 600;
    font-size: 14px;
    min-height: 40px;
    padding: 0 16px;
}
QPushButton[kuiperButton="true"][size="md"] {
    min-height: 40px; padding: 0 16px; font-size: 14px;
}
QPushButton[kuiperButton="true"][size="sm"] {
    min-height: 32px; padding: 0 12px; font-size: 14px;
}
QPushButton[kuiperButton="true"][size="xs"] {
    min-height: 24px; padding: 0 8px; font-size: 12px;
}
QPushButton[kuiperButton="true"][kind="primary"] {
    background-color: #0067b9;
    color: #ffffff;
}
QPushButton[kuiperButton="true"][kind="primary"]:hover,
QPushButton[kuiperButton="true"][kind="primary"]:pressed {
    background-color: #00427a;
    color: #ffffff;
}
QPushButton[kuiperButton="true"][kind="primary"]:disabled,
QPushButton[kuiperButton="true"][kind="primary"][processing="true"] {
    background-color: rgba(58, 142, 233, 0.56);
    color: #ffffff;
}
QPushButton[kuiperButton="true"][kind="secondary"] {
    background-color: transparent;
    border: 1px solid #0067b9;
    color: #0067b9;
}
QPushButton[kuiperButton="true"][kind="secondary"]:hover,
QPushButton[kuiperButton="true"][kind="secondary"]:pressed {
    background-color: rgba(146, 190, 252, 0.18);
    border: 1px solid #00427a;
    color: #00427a;
}
QPushButton[kuiperButton="true"][kind="secondary"]:disabled,
QPushButton[kuiperButton="true"][kind="secondary"][processing="true"] {
    border: 1px solid rgba(58, 142, 233, 0.56);
    color: rgba(58, 142, 233, 0.56);
}
QPushButton[kuiperButton="true"][kind="tertiary"] {
    background-color: transparent;
    border: 1px solid #848b95;
    color: #101820;
}
QPushButton[kuiperButton="true"][kind="tertiary"]:hover,
QPushButton[kuiperButton="true"][kind="tertiary"]:pressed {
    background-color: rgba(183, 187, 195, 0.2);
    border: 1px solid #5e6773;
    color: #101820;
}
QPushButton[kuiperButton="true"][kind="tertiary"]:disabled,
QPushButton[kuiperButton="true"][kind="tertiary"][processing="true"] {
    border: 1px solid rgba(132, 139, 149, 0.58);
    color: rgba(132, 139, 149, 0.58);
}
QPushButton[kuiperButton="true"][kind="ghost"] {
    background-color: transparent;
    color: #101820;
}
QPushButton[kuiperButton="true"][kind="ghost"]:hover,
QPushButton[kuiperButton="true"][kind="ghost"]:pressed {
    background-color: rgba(183, 187, 195, 0.2);
    color: #101820;
}
QPushButton[kuiperButton="true"][kind="ghost"]:disabled,
QPushButton[kuiperButton="true"][kind="ghost"][processing="true"] {
    color: rgba(132, 139, 149, 0.58);
}
QPushButton[kuiperButton="true"]:focus {
    border: 2px solid #b16ee0;
}

/* --- chrome --- */
QFrame[kuiperHeaderBar="true"] { background-color: #ffffff; border-bottom: 1px solid #b7bbc3; }
QFrame[kuiperDivider="true"] { background-color: #b7bbc3; max-height: 1px; min-height: 1px; }
/* --- KuiperCard --- */
QFrame[kuiperCard="true"] {
    background-color: #ffffff;
    border: 1px solid #b7bbc3;
    border-radius: 8px;
}
/* --- KuiperContainerHeader --- */
QLabel[kuiperHeading="true"] { color: #101820; font-weight: 700; font-size: 16px; }
QLabel[kuiperHeading="true"][density="low"] { font-size: 20px; font-weight: 600; }
QLabel[kuiperSubtitle="true"] { color: #5e6773; font-weight: 400; font-size: 14px; }
QLabel[kuiperCaption="true"] { color: #848b95; font-size: 12px; }
/* --- KuiperTag --- */
QLabel[kuiperTag="true"][status="info"] {
    background-color: #f0f1f3; color: #101820;
    border: 1px solid #b7bbc3; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
QLabel[kuiperTag="true"][status="success"] {
    background-color: #e4f6ef; color: #101820;
    border: 1px solid #2e9e6f; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
QLabel[kuiperTag="true"][status="warning"] {
    background-color: #feefe7; color: #101820;
    border: 1px solid #e76423; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
QLabel[kuiperTag="true"][status="danger"] {
    background-color: #feeeef; color: #c81a28;
    border: 1px solid #c81a28; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
QLabel[kuiperTag="true"][status="highlight"] {
    background-color: #f6eefc; color: #101820;
    border: 1px solid #b16ee0; border-radius: 4px;
    padding: 1px 6px; font-size: 12px; font-weight: 600;
}
/* --- KuiperProgressBar --- */
QProgressBar[kuiperProgress="true"] {
    background-color: rgba(132, 139, 149, 0.43);
    border: none; border-radius: 4px; max-height: 8px; min-height: 8px;
}
QProgressBar[kuiperProgress="true"]::chunk { background-color: #0067b9; border-radius: 4px; }
QProgressBar[kuiperProgress="true"][status="success"]::chunk { background-color: #2e9e6f; }
QProgressBar[kuiperProgress="true"][status="danger"]::chunk { background-color: #c81a28; }
/* --- KuiperLogView --- */
QPlainTextEdit[kuiperLog="true"] {
    background-color: #ffffff;
    color: #5e6773;
    border: 1px solid #848b95;
    border-radius: 4px;
    selection-background-color: #0067b9;
    selection-color: #ffffff;
}
/* --- KuiperSpinner --- */
KuiperSpinner { qproperty-arcColor: #0067b9; }
/* --- KuiperSegmentedControl --- */
QFrame[kuiperSegmented="true"] { border: 1px solid #848b95; border-radius: 4px; }
QPushButton[kuiperSegment="true"] {
    border: none; border-radius: 0; background-color: transparent;
    color: #101820;
    padding: 0 16px; min-height: 38px; font-size: 14px; font-weight: 600;
}
QPushButton[kuiperSegment="true"][pos="mid"], QPushButton[kuiperSegment="true"][pos="last"] {
    border-left: 1px solid #848b95;
}
QPushButton[kuiperSegment="true"][pos="first"] { border-top-left-radius: 3px; border-bottom-left-radius: 3px; }
QPushButton[kuiperSegment="true"][pos="last"] { border-top-right-radius: 3px; border-bottom-right-radius: 3px; }
QPushButton[kuiperSegment="true"]:checked {
    background-color: rgba(146, 190, 252, 0.18);
    color: #0067b9;
}
QPushButton[kuiperSegment="true"][compact="true"] { padding: 0 12px; min-height: 26px; font-size: 13px; }
/* --- KuiperCheckBox --- */
QCheckBox[kuiperCheck="true"] { color: #101820; spacing: 8px; font-size: 14px; }
QCheckBox[kuiperCheck="true"]::indicator {
    width: 16px; height: 16px; border-radius: 4px;
    border: 1px solid #848b95;
    background-color: #ffffff;
}
QCheckBox[kuiperCheck="true"]::indicator:hover { border-color: #5e6773; }
QCheckBox[kuiperCheck="true"]::indicator:checked {
    border: none; background-color: #0067b9;
    image: url(:/theme/check.svg);
}
/* --- QComboBox (dropdown skin) --- */
QComboBox {
    background-color: #ffffff;
    color: #101820;
    border: 1px solid #848b95;
    border-radius: 4px; padding: 4px 8px; min-height: 30px; font-size: 14px;
}
QComboBox:hover { border-color: #5e6773; }
QComboBox:focus { border: 2px solid #b16ee0; padding: 3px 7px; }
QComboBox:disabled {
    background-color: rgba(183, 187, 195, 0.2);
    color: #848b95;
    border-color: rgba(132, 139, 149, 0.58);
}
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #101820;
    border: 1px solid #b7bbc3;
    selection-background-color: #0067b9;
    selection-color: #ffffff;
    outline: none;
}
/* --- QLineEdit (input skin) --- */
QLineEdit {
    background-color: #ffffff;
    color: #101820;
    border: 1px solid #848b95;
    border-radius: 4px; padding: 4px 8px; min-height: 30px; font-size: 14px;
    selection-background-color: #0067b9;
    selection-color: #f0f1f3;
}
QLineEdit:hover { border-color: #5e6773; }
QLineEdit:focus { border: 2px solid #b16ee0; padding: 3px 7px; }
QLineEdit:disabled {
    background-color: rgba(183, 187, 195, 0.2);
    color: #848b95;
    border-color: rgba(132, 139, 149, 0.58);
}
/* --- KuiperBanner (subtle) --- */
QFrame[kuiperBanner="true"][status="info"] {
    background-color: #f0f1f3; border: 1px solid #b7bbc3; border-radius: 8px;
}
QFrame[kuiperBanner="true"][status="info"] QLabel { color: #101820; background: transparent; }
QFrame[kuiperBanner="true"][status="success"] {
    background-color: #e4f6ef; border: 1px solid #2e9e6f; border-radius: 8px;
}
QFrame[kuiperBanner="true"][status="success"] QLabel { color: #101820; background: transparent; }
QFrame[kuiperBanner="true"][status="warning"] {
    background-color: #feefe7; border: 1px solid #e76423; border-radius: 8px;
}
QFrame[kuiperBanner="true"][status="warning"] QLabel { color: #101820; background: transparent; }
QFrame[kuiperBanner="true"][status="danger"] {
    background-color: #feeeef; border: 1px solid #c81a28; border-radius: 8px;
}
QFrame[kuiperBanner="true"][status="danger"] QLabel { color: #c81a28; background: transparent; }
QFrame[kuiperBanner="true"][status="highlight"] {
    background-color: #f6eefc; border: 1px solid #b16ee0; border-radius: 8px;
}
QFrame[kuiperBanner="true"][status="highlight"] QLabel { color: #101820; background: transparent; }
